# Required on Render. Any long random value. Never commit it.
APP_SECRET=
# Optional. Derived from APP_SECRET when empty.
RX_ENC_KEY=

# Live AI reading of prescription photos. Leave empty to use the built-in samples and manual pharmacist review.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Comma-separated front-end origins that may call the API. Set this to your Vercel URL in production.
CORS_ORIGINS=*

# true keeps the one-click "Restart demo" endpoint. Set false for a real deployment (the endpoint then returns 404).
DEMO_MODE=true

# Optional path to the rules file (which schedules need a prescription, which are never sold online, prescription validity).
# Defaults to backend/data/rules.json.
RULES_FILE=
